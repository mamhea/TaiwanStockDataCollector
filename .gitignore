```gitignore
# Python cache
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/

# Environment variables and secrets
.env
.env.*
!.env.example

# SQLite databases
*.db
*.sqlite
*.sqlite3
data/database/*
!data/database/.gitkeep

# Exported data
data/exports/*
!data/exports/.gitkeep

# Logs
logs/*
!logs/.gitkeep
*.log

# Testing
.pytest_cache/
.coverage
htmlcov/

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db
